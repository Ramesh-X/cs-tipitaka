---
import Base from '@/layouts/Base.astro';
import { site } from '@/lib/site';
import { getRootNodes } from '@/lib/corpus';
import { asHref } from '@cs-tipitaka/shared';
import { getLocalDb } from '@cs-tipitaka/corpus/local';

const db = getLocalDb();
const roots = await getRootNodes(db);

const title = 'Page not found';
const description = 'This page does not exist on Tipiṭaka Online.';
---

<Base db={db} title={title} description={description}>
  <div
    class="mx-auto flex w-full max-w-2xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8"
  >
    <p
      class="font-reading text-sm font-medium tracking-wide text-muted-foreground uppercase"
    >
      404
    </p>
    <h1 class="mt-3 font-reading text-4xl font-semibold tracking-tight">
      Page not found
    </h1>
    <p class="mt-3 text-lg text-muted-foreground">
      The page you're looking for doesn't exist, or the link may be broken.
    </p>

    <a
      href={site.paths.search}
      class="mt-8 inline-flex items-center justify-center rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90"
    >
      Search the Tipiṭaka
    </a>

    <nav aria-label="Piṭaka sections" class="mt-12 w-full">
      <h2 class="text-sm font-medium text-muted-foreground">
        Or browse the three baskets
      </h2>
      <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          roots.map((node) => (
            <li>
              <a
                href={asHref(node.slug)}
                class="block rounded-lg border border-border bg-card px-4 py-3 font-reading text-base font-medium hover:border-foreground/30 hover:bg-muted/50"
              >
                {node.pali}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>
