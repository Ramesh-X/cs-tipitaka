---
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/json-ld.astro';
import Breadcrumbs from '@/components/breadcrumbs.astro';
import Pali from '@/components/reader/pali.astro';
import CorpusBrowser from '@/components/corpus-browser.astro';
import CorpusBrowserDisclosure from '@/components/corpus-browser-disclosure.astro';
import CorpusLayout from '@/components/corpus/corpus-layout.astro';
import TocList from '@/components/toc-list.astro';
import PaliReader from '@/components/reader/pali-reader.astro';
import SectionNav from '@/components/reader/section-nav.astro';
import DocumentPager from '@/components/document-pager.astro';
import {
  getAllPaths,
  findNode,
  getBreadcrumbs,
  getChildren,
  getAdjacentDocuments,
  isDocument,
  nodeTypeLabel,
  deriveReaderSections,
  type NodeWithMeta,
  type CorpusEntry,
} from '@/lib/corpus';
import type { ReaderSection } from '@/lib/corpus';
import type { Paragraph } from '@cs-tipitaka/corpus';
import { getLocalDb } from '@cs-tipitaka/corpus/local';
import { asHref } from '@cs-tipitaka/shared';
import { loadDocument } from '@/lib/corpus/data';
import CorpusToolbar from '@/components/corpus/corpus-toolbar';
import ReaderTranslations from '@/components/reader/reader-translations';
import { documentNode, collectionNode } from '@/lib/corpus/schema.ts';

export async function getStaticPaths() {
  const paths: string[] = await getAllPaths(getLocalDb());
  return paths.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const href = asHref(slug);
const slugArr = slug.split('/');
const db = getLocalDb();

const node = await findNode(db, slug);
if (!node) {
  return Astro.redirect('/404', 404);
}

const crumbs = await getBreadcrumbs(db, slug);
const isPartOfUrl = crumbs.length > 1 ? crumbs[crumbs.length - 2].href : '/';
const parentNode = node.parent_slug
  ? await findNode(db, node.parent_slug)
  : null;
const parentChildren = parentNode ? await getChildren(db, parentNode) : null;
const isPartOfType = parentChildren?.every(isDocument) ? 'Book' : 'BookSeries';

const pageTitle = `${node.pali} · Browse`;
const pageDescription = node.blurb
  ? `${node.blurb} — ${nodeTypeLabel(node.type)} — Tipiṭaka Online`
  : `${nodeTypeLabel(node.type)} — Tipiṭaka Online`;

const isDocumentNode = isDocument(node);

// Document branch data
let paragraphs: Paragraph[] = [];
let sections: ReaderSection[] = [];
let previous: CorpusEntry | undefined;
let next: CorpusEntry | undefined;
let docJsonLd: Record<string, unknown> | null = null;
// TOC branch data
let children: NodeWithMeta[] = [];
let tocJsonLd: Record<string, unknown> | null = null;

if (isDocumentNode) {
  const [content, adjacent] = await Promise.all([
    loadDocument(db, slug),
    getAdjacentDocuments(db, slugArr),
  ]);

  const derived = deriveReaderSections(content, node.pali);
  paragraphs = derived.paragraphs;
  sections = derived.sections;
  previous = adjacent.previous;
  next = adjacent.next;

  docJsonLd = {
    '@context': 'https://schema.org',
    ...documentNode({
      name: node.pali,
      description: node.blurb ?? undefined,
      url: href,
      isPartOfUrl,
      isPartOfType,
      wikidata: node.wikidata ?? undefined,
    }),
  };
} else {
  children = await getChildren(db, node);
  const childUrls = children.slice(0, 20).map((c) => asHref(c.slug));
  const isBook = children.length > 0 && children.every(isDocument);

  tocJsonLd = {
    '@context': 'https://schema.org',
    ...collectionNode({
      name: node.pali,
      description: node.blurb ?? undefined,
      url: href,
      isPartOfUrl,
      isPartOfType,
      wikidata: node.wikidata ?? undefined,
      childUrls,
      isBook,
    }),
  };
}

const ogType = isDocumentNode ? 'book' : 'website';
---

<Base
  db={db}
  title={pageTitle}
  description={pageDescription}
  canonical={slug}
  ogType={ogType}
>
  {docJsonLd && <JsonLd data={docJsonLd} />}
  {tocJsonLd && <JsonLd data={tocJsonLd} />}

  <div
    class="border-b border-border bg-background/80 px-4 py-3 sm:px-6 lg:px-8"
  >
    <Breadcrumbs crumbs={crumbs} />
  </div>

  {
    isDocumentNode ? (
      <CorpusLayout variant="document">
        <CorpusBrowser slot="nav" db={db} currentSlug={slugArr} />
        {sections.length > 0 && (
          <SectionNav slot="outline" sections={sections} />
        )}

        <div class="pb-16">
          <div class="mb-6">
            <h1 class="text-2xl font-bold tracking-tight">
              <Pali text={node.pali} />
            </h1>
            {node.blurb && (
              <p class="mt-3 text-muted-foreground">{node.blurb}</p>
            )}
          </div>

          <CorpusToolbar client:load />

          <div class="mb-4 xl:hidden">
            <CorpusBrowserDisclosure db={db} currentSlug={slugArr} />
          </div>

          {sections.length > 0 && (
            <details class="mb-4 rounded-lg border border-border xl:hidden">
              <summary class="flex cursor-pointer select-none list-none items-center gap-2 px-4 py-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4 text-muted-foreground"
                  aria-hidden="true"
                >
                  <path d="M3 12h.01" />
                  <path d="M3 18h.01" />
                  <path d="M3 6h.01" />
                  <path d="M8 12h13" />
                  <path d="M8 18h13" />
                  <path d="M8 6h13" />
                </svg>
                On this page
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-auto size-3.5 text-muted-foreground transition-transform in-[details[open]>summary]:rotate-90"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </summary>
              <div class="border-t border-border p-4">
                <SectionNav sections={sections} />
              </div>
            </details>
          )}

          <PaliReader paragraphs={paragraphs} />
          <ReaderTranslations client:load slug={slug} />
          <DocumentPager previous={previous} next={next} />
        </div>
      </CorpusLayout>
    ) : (
      <CorpusLayout variant="toc">
        <CorpusBrowser slot="nav" db={db} currentSlug={slugArr} />

        <div class="pb-16">
          <div class="mb-4 lg:hidden">
            <CorpusBrowserDisclosure db={db} currentSlug={slugArr} />
          </div>

          <div class="mb-6">
            <h1 class="text-2xl font-bold tracking-tight">
              <Pali text={node.pali} />
            </h1>
            {node.blurb && (
              <p class="mt-3 text-muted-foreground">{node.blurb}</p>
            )}
          </div>

          <TocList db={db} nodes={children} />
        </div>
      </CorpusLayout>
    )
  }
</Base>
