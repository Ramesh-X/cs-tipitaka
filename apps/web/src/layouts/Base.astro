---
import '@/styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import { themeInitScript } from '@/lib/theme';
import { transliterateInitScript } from '@/lib/transliterate-init';
import { layoutInitScript } from '@/lib/layout-init';
import { typographyInitScript } from '@/lib/typography-init';
import { loadNodes } from '@/lib/corpus/data';
import BaseHead from '@/components/base-head.astro';
import SiteHeader from '@/components/site-header.astro';
import SiteFooter from '@/components/site-footer.astro';
import ScriptAutoDetect from '@/components/reader/script-auto-detect';
import Transliterator from '@/components/reader/transliterator';
import type { CorpusDB } from '@cs-tipitaka/corpus';

interface Props {
  db: CorpusDB;
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
}

const { db, title, description, canonical, ogType } = Astro.props;
const nodes = await loadNodes(db);
---

<html
  lang="en"
  class="h-full antialiased"
  transition:animate={fade({ duration: '0.1s' })}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta
      name="theme-color"
      content="#fffaeb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#210602"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={transliterateInitScript} />
    <script is:inline set:html={layoutInitScript} />
    <script is:inline set:html={typographyInitScript} />
    <ClientRouter />
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
    />
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
    >
      Skip to content
    </a>
    <ScriptAutoDetect client:idle />
    <Transliterator client:load />
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter nodes={nodes} />

    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
      import { useReaderPreferences } from '@/lib/stores/reader-preferences';
      import { useLayoutPreferences } from '@/lib/stores/layout-preferences';
      import { transliterate } from '@/lib/corpus/reader';
      import { applyStoredTheme } from '@/lib/theme';
      import { CANONICAL_SCRIPT, SCRIPT_TO_BCP47 } from '@cs-tipitaka/shared';

      const NAV_SCROLL = '[data-nav-scroll]';
      let navScrollTop = 0;

      // Kept in lockstep with transliterator.tsx — docs/web/soft-navigation.md.
      function applyPrefs(doc: Document): void {
        const { script, fontSize, lineHeight, fontFamily } =
          useReaderPreferences.getState();

        if (script !== CANONICAL_SCRIPT) {
          doc.querySelectorAll<HTMLElement>('[data-pali]').forEach((s) => {
            if (!s.dataset.latn) {
              s.dataset.latn = s.textContent ?? '';
              if (s.children.length > 0) s.dataset.latnHtml = s.innerHTML;
            }
            s.textContent = transliterate(s.dataset.latn, script);
          });
        }

        const article = doc.querySelector<HTMLElement>('[data-reader-article]');
        if (article) {
          article.lang = SCRIPT_TO_BCP47[script] ?? 'pi-Latn';
          article.style.setProperty('--reader-font-size', `${fontSize}px`);
          article.style.setProperty('--reader-line-height', String(lineHeight));
          article.classList.toggle('font-reading', fontFamily === 'serif');
          article.classList.toggle('font-sans', fontFamily === 'sans');
        }

        const layout = doc.querySelector('[data-corpus-layout]');
        if (layout) {
          const { navCollapsed, outlineCollapsed } =
            useLayoutPreferences.getState();
          layout.setAttribute('data-nav-collapsed', String(navCollapsed));
          layout.setAttribute(
            'data-outline-collapsed',
            String(outlineCollapsed),
          );
        }
      }

      function onBeforeSwap(event: TransitionBeforeSwapEvent): void {
        applyPrefs(event.newDocument);
        navScrollTop =
          document.querySelector<HTMLElement>(NAV_SCROLL)?.scrollTop ?? 0;
      }

      function onAfterSwap(): void {
        applyStoredTheme();
        const el = document.querySelector<HTMLElement>(NAV_SCROLL);
        if (el) el.scrollTop = navScrollTop;
        // ClientRouter leaves focus on the clicked link, which the swap just
        // removed — move it to the landmark so keyboard/AT users land
        // somewhere sane, matching a full navigation's default behavior.
        document.getElementById('main')?.focus();
      }

      // The pane-collapse islands mount with client:media (M7.6) — below
      // their breakpoint they never hydrate, so their effect never clears
      // the pre-paint data-*-pending attribute. Harmless while the pane
      // stays hidden (the pending CSS only ever matches the "collapsed"
      // visual, same as the real state would), but clear it once the pane
      // is actually visible so a live viewport resize doesn't leave a
      // stale attribute sitting on <html> indefinitely.
      function clearStalePanePending(): void {
        const nav = document.querySelector<HTMLElement>('[data-pane="nav"]');
        if (nav && getComputedStyle(nav).display !== 'none') {
          document.documentElement.removeAttribute('data-nav-pending');
        }
        const outline = document.querySelector<HTMLElement>(
          '[data-pane="outline"]',
        );
        if (outline && getComputedStyle(outline).display !== 'none') {
          document.documentElement.removeAttribute('data-outline-pending');
        }
      }

      document.addEventListener('astro:before-swap', onBeforeSwap);
      document.addEventListener('astro:after-swap', onAfterSwap);
      document.addEventListener('astro:page-load', clearStalePanePending);
    </script>
  </body>
</html>
