---
import '@/styles/global.css';
import { themeInitScript } from '@/lib/theme';
import { transliterateInitScript } from '@/lib/transliterate-init';
import { getCorpusTree } from '@/lib/corpus/tree';
import BaseHead from '@/components/base-head.astro';
import SiteHeader from '@/components/site-header.astro';
import SiteFooter from '@/components/site-footer.astro';
import ScriptAutoDetect from '@/components/reader/script-auto-detect';
import Transliterator from '@/components/reader/transliterator';
import type { CorpusDB } from '@cs-tipitaka/corpus';

interface Props {
  db: CorpusDB;
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
}

const { db, title, description, canonical, ogType } = Astro.props;
const tree = await getCorpusTree(db);
---

<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={transliterateInitScript} />
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
    />
  </head>
  <body class="flex min-h-full flex-col">
    <ScriptAutoDetect client:idle />
    <Transliterator client:load />
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter tree={tree} />
  </body>
</html>
