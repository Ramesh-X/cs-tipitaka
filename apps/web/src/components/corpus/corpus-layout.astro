---
import { cn } from '@/lib/utils';
import PaneCollapseToggle from '@/components/corpus/pane-collapse-toggle';

interface Props {
  variant: 'document' | 'toc';
}

const { variant } = Astro.props;

const hasOutline = Astro.slots.has('outline');
const isDocument = variant === 'document';

const gridCols = isDocument
  ? hasOutline
    ? 'xl:grid-cols-[var(--nav-width,320px)_minmax(0,1fr)_var(--outline-width,260px)]'
    : 'xl:grid-cols-[var(--nav-width,320px)_minmax(0,1fr)]'
  : 'lg:grid-cols-[var(--nav-width,320px)_minmax(0,1fr)]';
---

<div
  class={cn('grid grid-cols-1 gap-0', gridCols)}
  data-corpus-layout
  data-variant={variant}
  data-nav-collapsed="false"
  data-outline-collapsed="false"
>
  <aside
    data-pane="nav"
    class={cn(
      'border-r border-border',
      isDocument ? 'hidden xl:block' : 'hidden lg:block',
    )}
  >
    <div
      data-nav-scroll
      class="sticky top-20 max-h-[calc(100vh-5rem)] overflow-auto p-4"
    >
      <PaneCollapseToggle pane="nav" client:load />
      <div data-pane-content="nav">
        <slot name="nav" />
      </div>
    </div>
  </aside>

  <main class="min-w-0 px-4 py-6 sm:px-6 lg:px-8">
    <slot />
  </main>

  {
    hasOutline && isDocument && (
      <aside data-pane="outline" class="hidden xl:block border-l border-border">
        <div class="sticky top-36 max-h-[calc(100vh-9rem)] overflow-y-auto p-4">
          <PaneCollapseToggle pane="outline" client:load />
          <div data-pane-content="outline">
            <slot name="outline" />
          </div>
        </div>
      </aside>
    )
  }
</div>

<style>
  [data-corpus-layout][data-nav-collapsed='true'] {
    --nav-width: 3rem;
  }
  [data-corpus-layout][data-outline-collapsed='true'] {
    --outline-width: 3rem;
  }
  [data-corpus-layout][data-nav-collapsed='true'] [data-pane-content='nav'] {
    display: none;
  }
  [data-corpus-layout][data-outline-collapsed='true']
    [data-pane-content='outline'] {
    display: none;
  }

  /* Pre-paint FOUC guard — docs/web/hydration-and-persistence.md */
  :root[data-nav-pending] [data-corpus-layout] {
    --nav-width: 3rem;
  }
  :root[data-nav-pending] [data-corpus-layout] [data-pane-content='nav'] {
    display: none;
  }
  :root[data-outline-pending] [data-corpus-layout] {
    --outline-width: 3rem;
  }
  :root[data-outline-pending]
    [data-corpus-layout]
    [data-pane-content='outline'] {
    display: none;
  }
</style>
