---
import ParagraphBlock from '@/components/reader/paragraph-block.astro';
import ReaderCopyActions from '@/components/reader/reader-copy-actions.astro';
import { classifyRend } from '@/lib/corpus/rend.ts';
import { computeHeadingLevels } from '@/lib/corpus/reader.ts';
import type { Paragraph } from '@cs-tipitaka/corpus';

interface Props {
  paragraphs: Paragraph[];
}

const { paragraphs } = Astro.props;
const headingLevels = computeHeadingLevels(paragraphs);
---

{
  paragraphs.length === 0 ? (
    <p class="py-8 text-center text-muted-foreground">
      This text is not yet available.
    </p>
  ) : (
    <article
      data-reader-article
      lang="pi-Latn"
      class="mx-auto flex flex-col max-w-5xl font-reading print:max-w-none"
      style="font-size: var(--reader-font-size, 19px); line-height: var(--reader-line-height, 1.5);"
    >
      <ReaderCopyActions />
      {paragraphs.map((p, i) => (
        <ParagraphBlock
          paragraph={p}
          prevClass={i > 0 ? classifyRend(paragraphs[i - 1].rend) : null}
          headingLevel={headingLevels.get(p.position)}
        />
      ))}
    </article>
  )
}
