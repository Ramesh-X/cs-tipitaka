---
import Pali from '@/components/reader/pali.astro';
import { classifyRend, type RendClass } from '@/components/reader/rend.ts';
import type { Paragraph } from '@cs-tipitaka/corpus';
import { cn } from '@/lib/utils';

interface Props {
  paragraph: Paragraph;
  prevClass: RendClass | null;
}

const { paragraph: p, prevClass } = Astro.props;

const rc = classifyRend(p.rend);
const isVerse = rc === 'verse';

// Top gap for body/verse paragraphs
function topGap(): string {
  if (isVerse) return prevClass === 'verse' ? 'mt-0' : 'mt-5';
  if (p.num) return 'mt-6';
  return 'mt-2';
}
---

{
  rc === 'banner' && (
    <div
      id={`para-${p.position}`}
      class="group relative mt-2 scroll-mt-32 first:mt-0"
    >
      <p class="text-center font-reading text-sm font-medium tracking-wide text-muted-foreground uppercase">
        <Pali text={p.pali} />
      </p>
    </div>
  )
}

{
  rc === 'chapter' && (
    <div
      id={`para-${p.position}`}
      class="group relative mt-10 mb-2 scroll-mt-32 first:mt-0"
    >
      <h2 class="text-center font-reading text-2xl font-semibold tracking-tight">
        <Pali text={p.pali} />
      </h2>
    </div>
  )
}

{
  rc === 'subhead' && (
    <div
      id={`para-${p.position}`}
      class="group relative mt-12 mb-1 scroll-mt-32 first:mt-0"
    >
      <div class="flex items-center gap-4">
        <span class="h-px flex-1 bg-border" aria-hidden="true" />
        <h3 class="text-center font-reading text-xl font-semibold tracking-tight">
          <Pali text={p.pali} />
        </h3>
        <span class="h-px flex-1 bg-border" aria-hidden="true" />
      </div>
    </div>
  )
}

{
  rc === 'subsubhead' && (
    <div
      id={`para-${p.position}`}
      class="group relative mt-6 mb-1 scroll-mt-32 first:mt-0"
    >
      <h4 class="text-center font-reading text-base font-semibold text-foreground/90">
        <Pali text={p.pali} />
      </h4>
    </div>
  )
}

{
  rc === 'centre' && (
    <div id={`para-${p.position}`} class="group relative my-5 scroll-mt-32">
      <p class="text-center font-reading text-sm font-medium text-muted-foreground">
        <Pali text={p.pali} />
      </p>
    </div>
  )
}

{
  (rc === 'body' || rc === 'verse') && (
    <div
      id={`para-${p.position}`}
      class={cn(
        'group relative scroll-mt-32 target:rounded-md target:bg-muted/30',
        topGap(),
      )}
    >
      <div
        class="absolute right-0 top-0 flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100"
        aria-hidden="true"
      >
        <button
          type="button"
          data-para-action="link"
          class="rounded p-1 text-muted-foreground/60 hover:bg-muted hover:text-muted-foreground"
          title="Copy link to paragraph"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
            aria-hidden="true"
          >
            <path d="M9 17H7A5 5 0 0 1 7 7h2" />
            <path d="M15 7h2a5 5 0 1 1 0 10h-2" />
            <line x1="8" x2="16" y1="12" y2="12" />
          </svg>
        </button>
        <button
          type="button"
          data-para-action="text"
          class="rounded p-1 text-muted-foreground/60 hover:bg-muted hover:text-muted-foreground"
          title="Copy paragraph text"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
            aria-hidden="true"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
        </button>
      </div>
      <div class="grid gap-x-10 gap-y-2" data-para-body>
        <p class={cn('text-foreground', isVerse && 'pl-6 italic')}>
          {p.num && (
            <span class="mr-1.5 font-semibold tabular-nums text-primary/80">
              {p.num}.
            </span>
          )}
          <Pali text={p.pali} />
        </p>
      </div>
      {(p.cst || p.pts) && (
        <div class="absolute top-full left-0 z-10 mt-0.5 flex items-center gap-2 text-[0.7em] text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100">
          {p.cst && <span class="font-mono">CST {p.cst}</span>}
          {p.pts && <span class="font-mono">PTS {p.pts}</span>}
        </div>
      )}
    </div>
  )
}

<script>
  type ArticleWithInit = HTMLElement & { _copyInit?: boolean };

  function init() {
    const article = document.querySelector(
      '[data-reader-article]',
    ) as ArticleWithInit | null;
    if (!article || article._copyInit) return;
    article._copyInit = true;

    article.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest(
        '[data-para-action]',
      ) as HTMLElement | null;
      if (!btn) return;

      const action = btn.dataset.paraAction;
      const paraEl = btn.closest('[id^="para-"]') as HTMLElement | null;
      if (!paraEl) return;

      const id = paraEl.id;
      let textToCopy = '';

      if (action === 'link') {
        textToCopy = location.origin + location.pathname + '#' + id;
      } else {
        const paliEl = paraEl.querySelector(
          '[data-pali]',
        ) as HTMLElement | null;
        textToCopy =
          paliEl?.dataset.latn ??
          paliEl?.textContent ??
          paraEl.textContent ??
          '';
      }

      await navigator.clipboard.writeText(textToCopy);

      // 1.5s check-mark feedback
      const svg = btn.querySelector('svg');
      if (svg) {
        const orig = svg.innerHTML;
        svg.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
        setTimeout(() => {
          svg.innerHTML = orig;
        }, 1500);
      }
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
