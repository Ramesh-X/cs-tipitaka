---
import { site } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  image?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  image,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortTitle}` : site.title;
const metaDescription = description ?? site.description;
const ogDescription = description ?? site.shortDescription;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url).href;
const imageUrl = new URL(image ?? site.ogImage, site.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.title} />

<meta name="twitter:card" content={site.twitter.card} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={imageUrl} />
