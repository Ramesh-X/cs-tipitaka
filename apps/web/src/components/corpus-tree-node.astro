---
import { getChildren, type NodeWithMeta } from '@/lib/corpus';
import { cn } from '@/lib/utils';
import type { CorpusDB } from '@cs-tipitaka/corpus';
import { asHref } from '@cs-tipitaka/shared';
import Pali from '@/components/reader/pali.astro';
import Self from '@/components/corpus-tree-node.astro';

interface Props {
  db: CorpusDB;
  node: NodeWithMeta;
  currentSlug: string;
}

const { db, node, currentSlug } = Astro.props;

const isActive = currentSlug === node.slug;
// Path-segment-safe prefix match — docs/web/corpus-navigation-tree.md.
const isAncestor = !isActive && currentSlug.startsWith(node.slug + '/');
const onActiveBranch = isActive || isAncestor;
const children = await getChildren(db, node);
const hasChildren = children.length > 0;
const isExpanded = onActiveBranch && hasChildren;
const href = asHref(node.slug);

const rowClasses = cn(
  'flex flex-1 items-center gap-1.5 rounded px-2 py-1 text-sm leading-snug whitespace-nowrap',
  'transition-colors hover:bg-muted',
  isActive && 'bg-primary/10 font-medium text-foreground',
  !isActive && 'text-muted-foreground',
);

// Rotation follows the live details[open] state, not the SSR-computed
// isExpanded flag — docs/web/corpus-navigation-tree.md.
const chevronClasses =
  'size-3.5 shrink-0 text-muted-foreground transition-transform in-[details[open]>summary]:rotate-90';
---

{
  isExpanded ? (
    <li>
      <details open>
        <summary
          class={cn(
            rowClasses,
            'cursor-pointer list-none [&::-webkit-details-marker]:hidden',
          )}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={chevronClasses}
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <a href={href} class="min-w-0 flex-1 truncate">
            <Pali text={node.pali} />
          </a>
        </summary>
        <ul class="ml-4 border-l border-border/50 pl-2">
          {children.map((child) => (
            <Self db={db} node={child} currentSlug={currentSlug} />
          ))}
        </ul>
      </details>
    </li>
  ) : hasChildren ? (
    <li>
      <a href={href} class={rowClasses}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={chevronClasses}
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
        <Pali text={node.pali} />
      </a>
    </li>
  ) : (
    <li>
      <div class="flex items-center gap-1 pl-5">
        <a href={href} class={rowClasses}>
          <Pali text={node.pali} />
        </a>
      </div>
    </li>
  )
}
