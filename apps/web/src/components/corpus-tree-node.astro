---
import { getChildren, type NodeWithMeta } from '@/lib/corpus';
import { cn } from '@/lib/utils';
import type { CorpusDB } from '@cs-tipitaka/corpus';
import { asHref } from '@cs-tipitaka/shared';
import Pali from '@/components/reader/pali.astro';
import Self from '@/components/corpus-tree-node.astro';

interface Props {
  db: CorpusDB;
  node: NodeWithMeta;
  currentSlug: string;
}

const { db, node, currentSlug } = Astro.props;

const isActive = currentSlug === node.slug;
const isAncestor = currentSlug.startsWith(node.slug) && !isActive;
const onActiveBranch = isActive || isAncestor;
const children = await getChildren(db, node);
const hasChildren = children.length > 0;
const isExpanded = onActiveBranch && hasChildren;
const href = asHref(node.slug);

const labelClasses = cn(
  'flex flex-1 items-center gap-1.5 rounded px-2 py-1 text-sm leading-snug whitespace-nowrap',
  'transition-colors hover:bg-muted',
  isActive && 'bg-primary/10 font-medium text-foreground',
  !isActive && 'text-muted-foreground',
);
---

{
  isExpanded && hasChildren ? (
    <li>
      <details open>
        <summary
          class={cn(
            'flex cursor-pointer list-none items-center gap-1 [&::-webkit-details-marker]:hidden',
          )}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5 shrink-0 text-muted-foreground transition-transform in-[details[open]>summary]:rotate-90"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <a href={href} class={labelClasses}>
            <Pali text={node.pali} />
          </a>
        </summary>
        <ul class="ml-4 border-l border-border/50 pl-2">
          {children.map((child) => (
            <Self db={db} node={child} currentSlug={currentSlug} />
          ))}
        </ul>
      </details>
    </li>
  ) : hasChildren ? (
    <li>
      <div class="flex items-center gap-1">
        <a
          href={href}
          aria-label={`Expand ${node.pali}`}
          class="shrink-0 rounded p-0.5 text-muted-foreground transition-colors hover:bg-muted"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
        <a href={href} class={labelClasses}>
          <Pali text={node.pali} />
        </a>
      </div>
    </li>
  ) : (
    <li>
      <div class="flex items-center gap-1 pl-5">
        <a href={href} class={labelClasses}>
          <Pali text={node.pali} />
        </a>
      </div>
    </li>
  )
}
