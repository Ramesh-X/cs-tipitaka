---
import { getRootNodes } from '@/lib/corpus';
import TreeNode from '@/components/corpus-tree-node.astro';
import { cn } from '@/lib/utils';
import type { CorpusDB } from '@cs-tipitaka/corpus';

interface Props {
  db: CorpusDB;
  currentSlug: string;
  class?: string;
  bare?: boolean;
}

const { db, currentSlug, class: className, bare = false } = Astro.props;

const rootNodes = await getRootNodes(db);
---

<nav
  aria-label="Browse Tipiṭaka"
  class={cn(
    !bare && 'rounded-lg border border-border bg-card p-3',
    'min-w-max',
    className,
  )}
>
  <ul class="space-y-0.5">
    {
      rootNodes.map((node) => (
        <TreeNode db={db} node={node} currentSlug={currentSlug} />
      ))
    }
  </ul>
</nav>
