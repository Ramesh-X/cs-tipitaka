# Base URL for apps/api, called client-side by the reader-translations island.
# Must be PUBLIC_-prefixed (Astro/Vite only expose PUBLIC_* vars to the browser).
# Defaults to https://api.tipitakaonline.org when unset — override for local
# dev against `pnpm run dev:api` (wrangler's default local port is 8787).
PUBLIC_API_URL=http://localhost:8787
