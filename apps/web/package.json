{
  "name": "@cs-tipitaka/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "fix-all": "pnpm run lint:fix && pnpm run format",
    "parity": "node --experimental-strip-types scripts/parity/check.ts",
    "parity:baseline": "node --experimental-strip-types scripts/parity/capture-baseline.ts",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@cs-tipitaka/corpus": "workspace:*",
    "@cs-tipitaka/shared": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pnfo/pali-converter": "^1.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "wrangler": "^4.113.0"
  }
}
