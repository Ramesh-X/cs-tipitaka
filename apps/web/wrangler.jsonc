{
  // Static-assets Worker for apps/web — serves tipitakaonline.org
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-tipitaka-web",
  "compatibility_date": "2025-08-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [{ "pattern": "tipitakaonline.org", "custom_domain": true }],
}
